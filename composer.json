{
  "name": "kamix/gestfinance",
  "description": "Système de gestion des besoins financiers",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "dompdf/dompdf": "^3.1.6",
    "vlucas/phpdotenv": "^5.6",
    "ext-pdo": "*",
    "phpmailer/phpmailer": "^7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "php migrate.php migrate",
    "migrate:status": "php migrate.php status"
  }
}
